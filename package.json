{
  "name": "guardiao-da-natureza",
  "version": "0.1.0",
  "private": true,
  "description": "Guardião da Natureza — ferramentas de desenvolvimento e animação",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config desenvolvimento/vite.config.mjs",
    "build": "vite build --config desenvolvimento/vite.config.mjs",
    "preview": "vite preview --config desenvolvimento/vite.config.mjs",
    "test": "node desenvolvimento/scripts/testar.mjs",
    "check:tools": "node desenvolvimento/scripts/verificar-ferramentas.mjs",
    "tools:install": "python3 desenvolvimento/scripts/instalar-editores.py",
    "test:build": "node desenvolvimento/scripts/testar.mjs --production",
    "check:site": "node desenvolvimento/scripts/verificar-site.mjs",
    "format:campaign": "prettier --write jogo/jornada/{fases,navegacao,sprites,jornada}.js jogo/jornada/jornada.css jogo/sistemas/{arte,controles,icones,progresso}.js jogo/sistemas/controles.css tela-inicial/campanha/*.{js,css}"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "prettier": "3.6.2",
    "vite": "8.3.5"
  }
}
